<?xml version="1.0" encoding="utf-8"?>
<!--
  Expanded music card.

  Only classes annotated @RemoteView may be inflated here: LinearLayout,
  TextView, ImageView, ImageButton and ProgressBar. In particular there is no
  bare <View> divider: RemoteViews rejects it at inflation time on the host,
  which is what makes the launcher show "No se pudo cargar el widget". The
  visual gap between sections is a layout margin instead.

  Icon colors are not declared here: they are applied from Kotlin through
  RemoteViews.setInt(..., "setColorFilter", ...), so this file stays free of
  attributes that some hosts resolve inconsistently.

  Structure: current track row (cover, texts, progress, transport controls)
  and the two upcoming queue rows. Every tap target owns a PendingIntent set
  from MusicWidgetProvider.onUpdate.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_gradient_border"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_cover"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_circle_placeholder"
            android:contentDescription="Carátula"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_media_play" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Sin reproducción"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="IVG Music"
                android:textAllCaps="true"
                android:textColor="#9E9EA8"
                android:textSize="11sp" />

            <ProgressBar
                android:id="@+id/pb_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="35"
                android:progressBackgroundTint="#2A2A35"
                android:progressTint="#00E5A3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="Canción anterior"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_media_previous" />

            <ImageButton
                android:id="@+id/btn_play"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="Reproducir o pausar"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_media_play" />

            <ImageButton
                android:id="@+id/btn_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="Canción siguiente"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_media_next" />
        </LinearLayout>
    </LinearLayout>

    <!--
      Section gap, expressed as a margin on the following row. A dedicated
      spacer <View> is not allowed in RemoteViews.
    -->
    <LinearLayout
        android:id="@+id/row_queue_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="4dp"
        android:paddingTop="4dp">

        <ImageView
            android:id="@+id/iv_queue_1"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_circle_placeholder"
            android:contentDescription="Siguiente en la cola"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_media_play" />

        <TextView
            android:id="@+id/tv_queue_1_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#E0E0E6"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_queue_1_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#9E9EA8"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_queue_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="4dp"
        android:paddingTop="4dp">

        <ImageView
            android:id="@+id/iv_queue_2"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_circle_placeholder"
            android:contentDescription="Después en la cola"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_media_play" />

        <TextView
            android:id="@+id/tv_queue_2_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#E0E0E6"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_queue_2_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#9E9EA8"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
