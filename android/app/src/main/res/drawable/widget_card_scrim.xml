<?xml version="1.0" encoding="utf-8"?>
<!--
  Scrim laid over the blurred artwork so the texts stay readable no matter
  what the cover looks like.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="22dp" />
    <gradient
        android:angle="270"
        android:centerColor="#D90D0D12"
        android:endColor="#F20D0D12"
        android:startColor="#B30D0D12"
        android:type="linear" />
</shape>
