<?xml version="1.0" encoding="utf-8"?>
<!--
  Stylized tonearm seen from above: rounded silver arm descending to the left,
  the pivot at the top and a white headshell at the tip.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="36dp"
    android:height="88dp"
    android:viewportWidth="36"
    android:viewportHeight="88">

    <!-- Arm, drawn as a rounded stroke so the tip reads smooth. -->
    <path
        android:pathData="M28.5,20 L13.5,72"
        android:strokeColor="#E0E0E8"
        android:strokeLineCap="round"
        android:strokeWidth="4" />

    <!-- Pivot. -->
    <path
        android:fillColor="#3A3A48"
        android:pathData="M21,12 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0 Z" />
    <path
        android:fillColor="#D0D0D8"
        android:pathData="M25,12 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 Z" />

    <!-- Headshell. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M9.5,72 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0 Z" />
</vector>
